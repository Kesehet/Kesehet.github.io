---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionIntro from "../components/SectionIntro.astro";
import Callout from "../components/Callout.astro";
import {
  capabilities,
  experienceNotes,
  featuredProjects,
  identity,
  secondaryProjects
} from "../data/portfolio";

const base = import.meta.env.BASE_URL;
const withBase = (value: string) => `${base}${value.replace(/^\//, "")}`;
---

<BaseLayout
  title={identity.name}
  description="Hamood Siddiqui builds Python APIs, backend systems, AI integrations, automation tools and practical full-stack applications."
  path="/"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">{identity.title}</p>
        <h1>Backend, AI and full-stack systems built to solve <em>real operational problems.</em></h1>
      </div>
      <div class="hero-aside">
        <p>{identity.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={withBase("/projects/")}>View selected work</a>
          <a class="button button-secondary" href={withBase("/contact/")}>Discuss a project</a>
        </div>
      </div>
    </div>
    <div class="shell hero-note" role="list" aria-label="Primary areas of work">
      <div role="listitem"><strong>Backend systems</strong><span>APIs, services and data workflows</span></div>
      <div role="listitem"><strong>AI integration</strong><span>Models connected to tools and products</span></div>
      <div role="listitem"><strong>Full-stack delivery</strong><span>From system boundary to usable interface</span></div>
    </div>
  </section>

  <section class="credibility">
    <div class="shell credibility-grid">
      <p class="eyebrow">What the work demonstrates</p>
      <div>
        <h2>More than framework familiarity: evidence of systems being connected end to end.</h2>
        <p>
          The selected work focuses on the difficult seams—model output and SQL, real-time audio
          and connection lifecycle, booking rules and client state, or local capture and background
          processing. Each case study leads with the major technical feat, then shows the code
          evidence and engineering decisions behind it.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="selected-work">
    <div class="shell">
      <SectionIntro
        eyebrow="Selected work"
        title="Engineering stories, not completion badges."
        copy="A project can demonstrate valuable engineering without being presented as a production launch. These case studies focus on the hardest verified problem tackled and the reasoning visible in the repository."
      />
      <div class="project-list">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <SectionIntro
        eyebrow="Capabilities"
        title="Useful software starts with the problem boundary."
        copy="I work across the stack when the product needs it, with the backend and operational workflow as the anchor."
      />
      <div class="capability-grid">
        {
          capabilities.map((capability, index) => (
            <article class="capability-card">
              <span class="number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{capability.title}</h3>
              <p>{capability.summary}</p>
              <small>{capability.evidence}</small>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Work experience"
        title="Patterns of work supported by repository evidence."
        copy="Formal employer names and dates remain under confirmation. The technical work itself already shows recurring areas of responsibility."
      />
      <div class="experience-list">
        {
          experienceNotes.map((item, index) => (
            <article class="experience-card">
              <span class="eyebrow">{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <small>Evidence: {item.proof}</small>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 2rem">
        <a class="text-link" href={withBase("/experience/")}>How I approach delivery ↗</a>
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <SectionIntro
        eyebrow="Selected achievements"
        title="Concrete technical milestones, without invented metrics."
      />
      <div>
        <div class="achievement-row">
          <strong>Schema-aware AI</strong>
          <p>Connected uploaded data, SQLite schema context, model tool calls, SQL execution and visual results in AiSQL.</p>
        </div>
        <div class="achievement-row">
          <strong>Non-blocking voice workflow</strong>
          <p>Separated audio capture from local Whisper inference and webhook delivery through a background queue.</p>
        </div>
        <div class="achievement-row">
          <strong>Full booking lifecycle</strong>
          <p>Modelled authentication, doctor discovery, availability, appointments and ratings across a Spring API and React client.</p>
        </div>
        <div class="achievement-row">
          <strong>Real-time connection lifecycle</strong>
          <p>Implemented broadcaster/listener WebRTC relay behavior and documented the point where an SFU architecture becomes necessary.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Secondary specialty"
        title="Game systems and interactive media."
        copy="Game development sits behind the primary backend and full-stack positioning, while still showing work on responsiveness, state and real-time interaction."
      />
      <div class="project-list">
        {secondaryProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <Callout
    title="Have a backend, AI or automation problem that needs a practical build?"
    copy="Share the workflow, constraint or system you are trying to improve. I’ll respond with the next useful technical conversation—not a generic sales pitch."
    href="/contact/"
    action="Discuss a project"
  />
</BaseLayout>
