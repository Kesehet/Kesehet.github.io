---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import Callout from "../components/Callout.astro";
import { featuredProjects, identity } from "../data/portfolio";

const base = import.meta.env.BASE_URL;
const withBase = (value: string) => `${base}${value.replace(/^\//, "")}`;
const highlightedProjects = featuredProjects.slice(0, 3);

const destinations = [
  {
    number: "01",
    title: "Projects",
    copy: "Open focused case studies covering the problem, major engineering feat, evidence, and next technical decision.",
    href: "/projects/",
    action: "Browse project stories"
  },
  {
    number: "02",
    title: "Experience",
    copy: "See the recurring responsibilities demonstrated across backend, AI, full-stack, and real-time systems.",
    href: "/experience/",
    action: "Review experience"
  },
  {
    number: "03",
    title: "Skills",
    copy: "Explore technologies grouped by the systems and workflows they help deliver—not decorative proficiency scores.",
    href: "/skills/",
    action: "Explore capabilities"
  },
  {
    number: "04",
    title: "About",
    copy: "Read how I approach system boundaries, inspectable workflows, security, and the distinction between evidence and intent.",
    href: "/about/",
    action: "How I work"
  }
];
---

<BaseLayout
  title={identity.name}
  description="Hamood Siddiqui brings nearly eight years of experience building Python APIs, backend systems, AI integrations, automation and full-stack applications."
  path="/"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{identity.title}</p>
        <h1>Backend systems, AI workflows, <em>websites &amp; apps.</em></h1>
        <div class="hero-aside">
          <p>{identity.intro}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={withBase("/projects/")}>View selected work</a>
            <a class="button button-secondary" href={withBase("/contact/")}>Contact me</a>
          </div>
        </div>
      </div>
      <figure class="hero-portrait">
        <img
          src={withBase("/images/hamood-siddiqui-portrait.png")}
          alt="Hamood Siddiqui wearing a light grey suit"
          width="960"
          height="1440"
          fetchpriority="high"
        />
      </figure>
    </div>
    <div class="shell hero-note" role="list" aria-label="Primary areas of work">
      <div role="listitem"><strong>Backend systems</strong><span>APIs, services and data workflows</span></div>
      <div role="listitem"><strong>AI integration</strong><span>Models connected to tools and products</span></div>
      <div role="listitem"><strong>Website &amp; app development</strong><span>From first concept to a polished, working product</span></div>
    </div>
  </section>

  <section class="credibility">
    <div class="shell credibility-grid">
      <p class="eyebrow">What the work demonstrates</p>
      <div>
        <h2>Evidence of difficult system boundaries being connected end to end.</h2>
        <p>
          Each case study isolates a meaningful engineering problem—model output and SQL,
          background audio processing, booking rules, or real-time connection state—and explains
          how the implementation connects those concerns into a usable system.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Explore my work"
        title="Experience, capabilities and projects—organized for a focused review."
        copy="Explore the area most relevant to your needs, from detailed engineering case studies to the responsibilities and technologies behind the work."
      />
      <div class="home-route-grid">
        {
          destinations.map((destination) => (
            <article class="home-route-card">
              <span class="number">{destination.number}</span>
              <h2>{destination.title}</h2>
              <p>{destination.copy}</p>
              <a class="text-link" href={withBase(destination.href)}>{destination.action} ↗</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <SectionIntro
        eyebrow="Featured project work"
        title="Selected systems and the major challenges they addressed."
        copy="Each project page covers the implementation, architecture, constraints and engineering lessons in detail."
      />
      <div class="home-project-list">
        {
          highlightedProjects.map((project, index) => (
            <article class="home-project-row">
              <span class="number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <p class="eyebrow">{project.category}</p>
                <h2><a href={withBase(`/projects/${project.slug}/`)}>{project.title}</a></h2>
              </div>
              <p>{project.majorFeat}</p>
              <a class="text-link" href={withBase(`/projects/${project.slug}/`)}>Open case study ↗</a>
            </article>
          ))
        }
      </div>
      <p class="section-action">
        <a class="button button-secondary" href={withBase("/projects/")}>View every project</a>
      </p>
    </div>
  </section>

  <Callout
    title="Looking for experienced help with a backend, AI or automation project?"
    copy="Share the workflow, constraints and outcome you need. I’ll help identify the practical technical path forward."
    href="/contact/"
    action="Contact Hamood"
  />
</BaseLayout>
