---
import BaseLayout from "../layouts/BaseLayout.astro";
import Callout from "../components/Callout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { experienceContexts, experienceNotes } from "../data/portfolio";
---

<BaseLayout
  title="Experience"
  description="Nearly eight years of hands-on experience across backend systems, AI integrations, full-stack applications and service platforms."
  path="/experience/"
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Experience</p>
      <h1>Nearly eight years of building systems, services and practical products.</h1>
      <p class="lead">
        My work includes Media Pitch and service platforms such as MarketGenics and Fill Masjid,
        alongside backend, AI, automation, full-stack and real-time projects. The focus is on what I
        helped build, the responsibilities involved and the engineering problems tackled.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Service context"
        title="Experience shaped by real platforms and operating needs."
        copy="This work spans customer-facing platforms, internal operations, AI services and community-focused real-time systems."
      />
      <div class="experience-list">
        {
          experienceContexts.map((item, index) => (
            <article class="experience-card">
              <span class="eyebrow">{String(index + 1).padStart(2, "0")}</span>
              <h3><a href={item.href} target="_blank" rel="noopener">{item.title}</a></h3>
              <p>{item.copy}</p>
              <small>{new URL(item.href).hostname.replace(/^www\./, "")} ↗</small>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <SectionIntro
        eyebrow="Technical experience"
        title="Responsibility demonstrated through systems and decisions."
        copy="The recurring patterns below are demonstrated across the project case studies."
      />
      {
        experienceNotes.map((item, index) => (
          <div class="achievement-row">
            <strong>{String(index + 1).padStart(2, "0")} · {item.title}</strong>
            <div>
              <p>{item.copy}</p>
              <p><small>Project evidence: {item.proof}</small></p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="shell split-layout">
      <div class="sticky-label">
        <p class="eyebrow">Delivery approach</p>
        <h2>From ambiguity to an inspectable build.</h2>
      </div>
      <div>
        <div class="skill-group">
          <h3>1. Establish the operational problem</h3>
          <p>Identify the user, repeated task, source of truth and consequence of failure.</p>
        </div>
        <div class="skill-group">
          <h3>2. Draw the system boundary</h3>
          <p>Separate client, service, data, model and third-party responsibilities before selecting abstractions.</p>
        </div>
        <div class="skill-group">
          <h3>3. Build the evidence path</h3>
          <p>Make important transformations and state transitions visible enough to debug and explain.</p>
        </div>
        <div class="skill-group">
          <h3>4. Review security and operations</h3>
          <p>Check configuration, access control, storage, failure states and deployment constraints before calling the work ready.</p>
        </div>
      </div>
    </div>
  </section>

  <Callout
    title="Need experienced ownership of a software problem?"
    copy="Share the workflow that is slow, disconnected or difficult to maintain. I can help turn it into a clear technical plan and working system."
    href="/contact/"
    action="Contact Hamood"
  />
</BaseLayout>
