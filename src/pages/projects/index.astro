---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Callout from "../../components/Callout.astro";
import { visibleProjects } from "../../data/portfolio";

const base = import.meta.env.BASE_URL;
const withBase = (value: string) => `${base}${value.replace(/^\//, "")}`;
const categories = ["All", ...new Set(visibleProjects.map((project) => project.category))];
---

<BaseLayout
  title="Projects"
  description="Case studies of backend systems, AI integrations, automation workflows and full-stack applications built by Hamood Siddiqui."
  path="/projects/"
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Projects</p>
      <h1>The difficult part of each system, explained clearly.</h1>
      <p class="lead">
        Each project is organized around the business or operational problem, the major engineering
        feat, the implemented architecture and the decisions that would strengthen it further.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="filter-bar" role="group" aria-label="Filter projects">
        {
          categories.map((category, index) => (
            <button
              type="button"
              data-filter={category}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {category}
            </button>
          ))
        }
      </div>
      <div class="all-projects" data-project-grid>
        {
          visibleProjects.map((project) => (
            <article class="all-project-card" data-category={project.category}>
              <p class="eyebrow">{project.category}</p>
              <h2><a href={withBase(`/projects/${project.slug}/`)}>{project.title}</a></h2>
              <p>{project.valueProposition}</p>
              <div class="feat-block">
                <span>Major engineering feat</span>
                <p>{project.majorFeat}</p>
              </div>
              <div class="project-card-meta">
                <span>{project.statusLabel}</span>
                <span>{project.verificationStatus}</span>
              </div>
              <a class="text-link" href={withBase(`/projects/${project.slug}/`)}>Read case study ↗</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Callout
    title="Looking for experience that matches your project?"
    copy="Tell me what needs to connect, automate, stabilize or scale. I’ll relate it to the most relevant work and technical approach."
    href="/contact/"
    action="Contact Hamood"
  />
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-category]")];
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.dataset.filter;
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        cards.forEach((card) => {
          card.hidden = selected !== "All" && card.dataset.category !== selected;
        });
      });
    });
  </script>
</BaseLayout>
