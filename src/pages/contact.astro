---
import BaseLayout from "../layouts/BaseLayout.astro";
import { identity } from "../data/portfolio";

const endpoint =
  import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://api.example.com/contact.php";
const endpointReady = !endpoint.includes("example.com");
const base = import.meta.env.BASE_URL;
const withBase = (value: string) => `${base}${value.replace(/^\//, "")}`;
---

<BaseLayout
  title="Contact"
  description="Contact Hamood Siddiqui about backend, AI integration, automation and full-stack software projects."
  path="/contact/"
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1>Tell me what needs to work better.</h1>
      <p class="lead">
        A useful first message includes the current workflow, the people affected, the constraint
        that matters most and what a successful next step would change.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Direct profiles</p>
        <div class="contact-options">
          <a href={identity.linkedin} target="_blank" rel="noopener"><span>LinkedIn</span><span>↗</span></a>
          <a href={identity.github} target="_blank" rel="noopener"><span>GitHub</span><span>↗</span></a>
        </div>
        <p style="margin-top: 2rem; color: var(--muted)">
          A public email will appear here after confirmation. Telephone details are not published by
          default.
        </p>
      </div>
      <form
        class="contact-form"
        action={endpoint}
        method="post"
        accept-charset="UTF-8"
        data-contact-form
        data-endpoint-ready={String(endpointReady)}
      >
        <div class="field-grid">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="company">Company <small>(optional)</small></label>
            <input id="company" name="company" type="text" autocomplete="organization" maxlength="120" />
          </div>
          <div class="field">
            <label for="project_type">Project type <small>(optional)</small></label>
            <select id="project_type" name="project_type">
              <option value="">Select one</option>
              <option>Backend or API</option>
              <option>AI integration</option>
              <option>Automation</option>
              <option>Full-stack application</option>
              <option>Technical consultation</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="message">What are you trying to solve?</label>
          <textarea id="message" name="message" minlength="20" maxlength="5000" required></textarea>
          <small>20–5,000 characters. Please do not include credentials or sensitive personal data.</small>
        </div>
        <div class="honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="consent">
          <input name="consent" type="checkbox" value="yes" required />
          <span>
            I consent to this information being used to respond to my enquiry. Read the
            <a href={withBase("/privacy/")}>contact privacy notice</a>.
          </span>
        </label>
        <button class="button button-primary" type="submit" disabled={!endpointReady}>
          {endpointReady ? "Send enquiry" : "Form endpoint awaiting configuration"}
        </button>
        <p class="form-status" role="status" aria-live="polite" data-form-status>
          {!endpointReady && "The contact form will be enabled after the PHP endpoint is configured."}
        </p>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const status = document.querySelector<HTMLElement>("[data-form-status]");
    form?.addEventListener("submit", async (event) => {
      if (form.dataset.endpointReady !== "true") return;
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!submit || !status) return;
      submit.disabled = true;
      submit.textContent = "Sending…";
      status.dataset.state = "loading";
      status.textContent = "Sending your enquiry…";
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" }
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.message || "The server could not accept the message.");
        form.reset();
        status.dataset.state = "success";
        status.textContent = payload?.message || "Thanks—your enquiry was sent.";
      } catch (error) {
        status.dataset.state = "error";
        status.textContent =
          error instanceof Error
            ? `${error.message} Please try again or use LinkedIn.`
            : "Something went wrong. Please try again or use LinkedIn.";
      } finally {
        submit.disabled = false;
        submit.textContent = "Send enquiry";
      }
    });
  </script>
</BaseLayout>
