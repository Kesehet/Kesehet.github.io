---
import BaseLayout from "../layouts/BaseLayout.astro";
import { identity } from "../data/portfolio";

const subject = encodeURIComponent("Project enquiry for Hamood Siddiqui");
const emailHref = `mailto:${identity.email}?subject=${subject}`;
---

<BaseLayout
  title="Contact"
  description="Contact Hamood Siddiqui about backend systems, AI integrations, automation and full-stack software projects."
  path="/contact/"
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1>Let’s talk about the system you need to build or improve.</h1>
      <p class="lead">
        I work with teams and service businesses on backend platforms, AI-enabled workflows,
        automation and full-stack products. Share the current challenge and the outcome you are
        working toward.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">Direct contact</p>
        <h2 class="contact-heading">Reach me directly.</h2>
        <div class="contact-options">
          <a href={`mailto:${identity.email}`}>
            <span>Email</span><strong>{identity.email}</strong>
          </a>
          <a href={identity.phoneHref}>
            <span>Phone</span><strong>{identity.phone}</strong>
          </a>
          <a href={identity.linkedin} target="_blank" rel="noopener">
            <span>LinkedIn</span><span>View profile ↗</span>
          </a>
          <a href={identity.github} target="_blank" rel="noopener">
            <span>GitHub</span><span>View repositories ↗</span>
          </a>
        </div>
      </div>

      <article class="contact-card">
        <p class="eyebrow">A useful first message</p>
        <h2>Give me enough context to understand the real problem.</h2>
        <ul class="plain-list">
          <li>The workflow, product or service you are improving</li>
          <li>The people who use it and where the current friction appears</li>
          <li>The systems, data sources or integrations already involved</li>
          <li>The outcome that would make the engagement successful</li>
        </ul>
        <a class="button button-primary" href={emailHref}>Email Hamood</a>
        <p class="contact-note">
          Please do not send passwords, API keys, financial records or sensitive personal data.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
