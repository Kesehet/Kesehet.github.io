---
import BaseLayout from "../layouts/BaseLayout.astro";
import { identity } from "../data/portfolio";
---

<BaseLayout
  title="Contact privacy"
  description="Privacy information for contacting Hamood Siddiqui about professional work."
  path="/privacy/"
>
  <header class="page-hero">
    <div class="narrow">
      <p class="eyebrow">Privacy</p>
      <h1>Professional contact and privacy.</h1>
      <p class="lead">How information shared through email, telephone or professional profiles is handled.</p>
    </div>
  </header>
  <article class="section narrow prose">
    <h2>Information you choose to share</h2>
    <p>
      When you contact me, I receive the details included in your message or call, such as your
      name, contact information, organization and project context.
    </p>
    <h2>How it is used</h2>
    <p>
      Contact information is used to understand your enquiry, respond to you and maintain the
      correspondence needed for a potential or active professional engagement.
    </p>
    <h2>Confidential information</h2>
    <p>
      Please do not send passwords, API keys, payment information, health records or other
      sensitive material through an initial enquiry. Secure sharing arrangements can be agreed
      when a project requires them.
    </p>
    <h2>Your choices</h2>
    <p>
      You may ask for a previous enquiry to be corrected or deleted by emailing
      <a href={`mailto:${identity.email}`}>{identity.email}</a>.
    </p>
  </article>
</BaseLayout>
