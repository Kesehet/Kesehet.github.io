---
import type { PortfolioProject } from "../data/portfolio";

interface Props {
  project: PortfolioProject;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (value: string) => `${base}${value.replace(/^\//, "")}`;
const media = project.media[0];
---

<article class="project-card">
  <div class="project-card-content">
    <div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
    <div>
      <p class="eyebrow">{project.eyebrow}</p>
      <h3><a href={withBase(`/projects/${project.slug}/`)}>{project.title}</a></h3>
      <p class="project-value">{project.valueProposition}</p>
    </div>
    <div class="feat-block">
      <span>Major engineering feat</span>
      <p>{project.majorFeat}</p>
    </div>
    <div class="project-card-meta">
      <span>{project.statusLabel}</span>
      <span>{project.technologies.slice(0, 4).join(" · ")}</span>
    </div>
    <a class="text-link" href={withBase(`/projects/${project.slug}/`)}>
      Read the engineering story <span aria-hidden="true">↗</span>
    </a>
  </div>
  {
    media ? (
      <figure class="project-card-media">
        <img
          src={withBase(media.src)}
          alt={media.alt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>
          <span>{media.kind === "concept" ? "Concept visual" : "Project media"}</span>
          {media.caption}
        </figcaption>
      </figure>
    ) : (
      <div class={`project-system project-system-${(index % 3) + 1}`} aria-hidden="true">
        <span></span><span></span><span></span><i></i><i></i>
      </div>
    )
  }
</article>
