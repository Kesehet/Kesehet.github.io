---
import { identity } from "../data/portfolio";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const withBase = (value: string) => `${base}${value.replace(/^\//, "")}`;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href={withBase("/")}>
        <span class="brand-mark" aria-hidden="true">HS</span>
        <span>{identity.name}</span>
      </a>
      <p>{identity.positioning}</p>
    </div>
    <div>
      <p class="footer-label">Navigate</p>
      <a href={withBase("/projects/")}>Selected work</a>
      <a href={withBase("/contact/")}>Contact Hamood</a>
      <a href={withBase("/privacy/")}>Privacy</a>
    </div>
    <div>
      <p class="footer-label">Connect</p>
      <a href={`mailto:${identity.email}`}>{identity.email}</a>
      <a href={identity.phoneHref}>{identity.phone}</a>
      <a href={identity.github} rel="me noopener" target="_blank">GitHub</a>
      <a href={identity.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} {identity.name}</span>
    <span>Designed and built by Hamood Siddiqui.</span>
  </div>
</footer>
